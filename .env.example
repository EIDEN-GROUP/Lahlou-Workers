# --- Supabase (required in prod) ---
SUPABASE_URL=https://xyz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...NEVER expose to client

# --- Single admin auth ---
# Preferred: bcrypt hash of the admin password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('votre-mot-de-passe-fort', 12))"
ADMIN_PASSWORD_HASH=$2b$12$...
# Dev fallback only (plain). Prefer HASH above.
# ADMIN_PASSWORD=change-me
# 32+ chars random secret for signing session cookies:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me-32-chars-minimum-random-secret-here

# --- SMTP / nodemailer (notifications) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=lahlou.workers@gmail.com
SMTP_PASS=xxxx-app-password
MAIL_FROM="Lahlou Workers <lahlou.workers@gmail.com>"
MAIL_TO=lahlou.workers@gmail.com

# --- Public contact (Vite client) ---
# E.164 without + (WhatsApp). Leave empty to hide WhatsApp button until real number known.
VITE_WHATSAPP_NUMBER=
# Server-side mirror (same number)
PUBLIC_WHATSAPP_NUMBER=
VITE_SITE_URL=https://lahlou-workers.com
